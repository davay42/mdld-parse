{
	"name": "mdld-parse",
	"version": "1.2.1",
	"description": "Write RDF knowledge graphs as plain Markdown. Parse to quads, generate back, merge documents. The human-friendly semantic web format.",
	"keywords": [
		"rdf",
		"linked-data",
		"semantic-web",
		"knowledge-graph",
		"markdown",
		"semantic-annotations",
		"provenance",
		"prov-o",
		"shacl",
		"agent-memory",
		"llm",
		"md-ld",
		"mdld",
		"semantic-markdown",
		"quad-store",
		"crdt",
		"rdfs",
		"ontology",
		"triple-store"
	],
	"type": "module",
	"main": "./dist/mdld-parse.js",
	"exports": {
		".": "./dist/mdld-parse.js",
		"./graph": "./dist/quad-graph.js",
		"./crawl": "./dist/crawl.js",
		"./shapes": "./dist/shapes.js"
	},
	"files": [
		"dist/mdld-parse.js",
		"dist/quad-graph.js",
		"dist/crawl.js",
		"dist/shapes.js"
	],
	"scripts": {
		"test": "node tests/index.js",
		"dev": "vite dev",
		"build": "vite build && vite build --config vite.config.lib.js && cp -r docs/ dist/docs/ && cp -r server/ dist/server/ && cp -r examples/ dist/examples/ && cp -r grammar/ dist/grammar/  && cp -r ontologies/ dist/ontologies/ && cp -r spec/ dist/spec/ && cp -r README.md dist/README.md && cp -r docs.html dist/docs.html && cp -r demo/ dist/demo/ && cp -r src/ dist/src/"
	},
	"author": "davay42",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/davay42/mdld-parse.git"
	},
	"homepage": "https://mdld.js.org/",
	"bugs": {
		"url": "https://github.com/davay42/mdld-parse/issues"
	},
	"devDependencies": {
		"@unocss/extractor-pug": "^66.13.0",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vueuse/core": "^15.0.0",
		"codejar": "^5.0.0",
		"markdown-it": "^15.0.3",
		"n3": "^2.13.12",
		"rdfa-parse": "^1.0.1",
		"shiki": "^4.6.0",
		"unocss": "^66.13.0",
		"vite": "^8.3.8",
		"vite-plugin-singlefile": "^2.3.4",
		"vscode-textmate": "^9.3.2",
		"vue": "^3.6.0-beta.17"
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
